#include <stdio.h>
#include <stdlib.h>
#include <locale.h>


typedef struct Node {
    int data;
    struct Node* next;
    struct Node* prev;
} Node;

Node* createNode(int value) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    if (!newNode) return NULL;
    newNode->data = value;
    newNode->next = NULL;
    newNode->prev = NULL;
    return newNode;
}


void printList(Node* head) {
    if (!head) {
        printf("Список пуст.\n");
        return;
    }
    Node* temp = head;
    while (temp) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
    printf("\n");
}

Node* SortList_(Node* head)
{
    if (head == NULL) return NULL;

    bool changed = true;

    while (changed)
    {
        if (changed == true) changed = false;

        Node* temp = head;

        while (temp->next != NULL)
        {
            if (temp->data > temp->next->data)
            {
                int tempValue = temp->data;
                temp->data = temp->next->data;
                temp->next->data = tempValue;
                changed = true;
            }

            temp = temp->next;
        }
    }

    return head;
}

void freeList(Node** head) {
    Node* current = *head;
    Node* next;
    while (current != NULL) {
        next = current->next;
        free(current);
        current = next;
    }
    *head = NULL;
}

int main() {
    setlocale(LC_ALL, "rus");
    int arr[] = { 42, 7, 13, 1, 99, 24 };
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Исходный массив: ");
    for (int i = 0; i < n; i++) printf("%d ", arr[i]);
    printf("\n\n");

    Node* head = NULL;
    Node* tail = NULL;

    for (int i = 0; i < n; i++) {
        Node* newNode = createNode(arr[i]);
        if (!head) {
            head = tail = newNode;
        }
        else {
            tail->next = newNode;
            newNode->prev = tail;
            tail = newNode;
        }
    }

    // 3. Печатаем список
    printf("Созданный список: ");
    printList(head);

    // 4. Сортируем список
    head = SortList_(head);

    // 5. Печатаем отсортированный список
    printf("Отсортированный список: ");
    printList(head);

    // 6. Очищаем память
    freeList(&head);
    printf("\nПамять очищена.\n");

    return 0;
}
